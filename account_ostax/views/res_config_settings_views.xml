<odoo>
    <record id="res_config_settings_view_form_ostax" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ostax</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Cross-version stable xpath: Odoo 16: //div[@data-key='account'] (different from 17/18/19 which use //app[@name='account']). The
                 16.0 branch overrides this to //div[@data-key='account']
                 because Odoo 16's settings view uses a different
                 wrapper element. -->
            <xpath expr="//div[@data-key='account']" position="inside">
                <block title="OpenSalesTax — destination-based US sales tax"
                       id="ostax_settings_block">

                    <setting id="ostax_enable_setting"
                             string="Enable OpenSalesTax"
                             help="Replace static US tax rates with destination-based calculation against your OpenSalesTax engine. Engages automatically for US partners with a valid 5-digit ZIP.">
                        <field name="ostax_enabled"/>
                    </setting>

                    <setting id="ostax_engine_url_setting"
                             string="Engine URL"
                             help="Base URL of your OpenSalesTax engine instance. Run your own — no per-transaction fees, no data leaves your infrastructure."
                             invisible="not ostax_enabled">
                        <field name="ostax_api_url"
                               placeholder="http://your-ost.example.com:8080"/>
                        <div class="mt-2">
                            <button type="object"
                                    name="action_ostax_test_connection"
                                    string="Test Connection"
                                    class="btn-secondary btn-sm"
                                    icon="fa-link"/>
                        </div>
                    </setting>

                    <setting id="ostax_api_key_setting"
                             string="API key (optional)"
                             help="Bearer token forwarded to the engine. Leave blank if your engine doesn't require authentication."
                             invisible="not ostax_enabled">
                        <field name="ostax_api_key"
                               password="True"
                               placeholder="optional Bearer token"/>
                    </setting>

                    <setting id="ostax_origin_setting"
                             string="Origin / nexus address"
                             help="Your shipping origin partner. Used as the destination for vendor-bill use-tax accrual (v0.2)."
                             invisible="not ostax_enabled">
                        <field name="ostax_origin_address_id"/>
                    </setting>

                    <setting id="ostax_cache_setting"
                             string="Rate cache TTL (hours)"
                             help="How long to cache ZIP→rate-stack lookups in worker memory. Default 24h."
                             invisible="not ostax_enabled">
                        <field name="ostax_cache_ttl_hours"/>
                    </setting>

                    <setting id="ostax_failsoft_setting"
                             string="Fail-soft on engine error"
                             help="When the engine is unreachable or returns 5xx, fall back to the catalog rate and log a warning. When off, surface the error to the user (blocks checkout)."
                             invisible="not ostax_enabled">
                        <field name="ostax_fail_soft"/>
                    </setting>

                    <setting id="ostax_pos_setting"
                             string="POS live quote"
                             help="When on, the POS frontend calls the engine on every line-add for an accurate cashier preview. Adds 150-300ms latency per line over LAN. When off, the cashier preview uses the catalog rate; the receipt shows the OST-computed rate. (v0.2)"
                             invisible="not ostax_enabled">
                        <field name="ostax_pos_live_quote"/>
                    </setting>

                    <setting id="ostax_debug_setting"
                             string="Debug log"
                             help="Record recent calculations in a 50-entry ring buffer. Visible under Settings → Technical → OpenSalesTax → Recent calculations."
                             invisible="not ostax_enabled">
                        <field name="ostax_debug_log_enabled"/>
                    </setting>

                    <setting id="ostax_disclaimer_setting"
                             invisible="not ostax_enabled">
                        <div class="text-muted" style="font-size: 0.85em;">
                            <strong>Calculation only.</strong>
                            Tax calculations are provided as-is for convenience.
                            The merchant is solely responsible for tax-collection
                            accuracy and remittance to the appropriate
                            jurisdictions. Verify against your state Department
                            of Revenue before remitting.
                        </div>
                    </setting>

                </block>
            </xpath>

        </field>
    </record>
</odoo>
