<odoo>
    <record id="view_account_move_form_ostax" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ostax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="OpenSalesTax" name="ostax_breakdown_tab"
                      invisible="not ostax_breakdown and not ostax_calculated_at">
                    <group>
                        <group>
                            <field name="ostax_engine_version" readonly="1"/>
                            <field name="ostax_calculated_at" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_ostax_recompute_breakdown"
                                    type="object"
                                    string="Recompute Breakdown"
                                    icon="fa-refresh"
                                    invisible="state != 'draft'"
                                    class="btn-secondary"/>
                        </group>
                    </group>
                    <separator string="Per-jurisdiction breakdown (audit JSON)"/>
                    <field name="ostax_breakdown" readonly="1" widget="text"/>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
