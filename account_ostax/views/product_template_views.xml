<odoo>
    <record id="view_product_template_form_ostax" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ostax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Add OST category right after the existing "Customer Taxes"
                 field on the Accounting tab — the natural neighbour for
                 anything tax-related. -->
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="ostax_category"
                       widget="selection"
                       help="Per-state taxability category sent to the OpenSalesTax engine. Choose a special category (Clothing, Groceries, Prescription drugs, Prepared food, Digital goods) when the product matches one of the engine's per-state rules — otherwise leave at General."/>
            </xpath>

        </field>
    </record>
</odoo>
